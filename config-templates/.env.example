# QX 既有凭据接入 DeerFlow（运行时配置，上游已 gitignore）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
TAVILY_API_KEY=<your-key>
SILICONFLOW_API_KEY=
# QX 工具
QX_SOURCES_DIR=/home/administrator/dev/agents
QX_OUTPUT_DIR=/home/administrator/dev/agents/qx-deerflow/runtime/outputs
QX_MOD_SOURCE=rainforest
# 直连 Gateway（绕过 nginx 的开发访问）
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://localhost:2026,https://podcasts-spirit-debian-farmers.trycloudflare.com
DEEPSEEK_API_KEY=<your-key>
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=1
AUTH_JWT_SECRET=<generate-via-openssl-rand>
