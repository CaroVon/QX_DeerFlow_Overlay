{
  "mcpInterceptors": [
    "my_package.mcp.auth:build_auth_interceptor"
  ],
  "mcpServers": {
    "github": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      },
      "description": "GitHub MCP server for repository operations"
    },
    "postgres": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost/mydb"
      ],
      "env": {},
      "description": "PostgreSQL database access"
    },
    "qx-studio": {
      "enabled": true,
      "type": "stdio",
      "command": "/home/administrator/dev/agents/qx-deerflow/deer-flow/backend/.venv/bin/python",
      "args": [
        "-m",
        "qx_mcp.server"
      ],
      "env": {
        "QX_API_BASE": "http://localhost:8000",
        "QX_MCP_MODE": "direct",
        "QX_BACKEND_DIR": "/home/administrator/dev/agents/QX_product_agent/backend"
      },
      "description": "QX Product Studio long-running pipeline (submit/status/cancel)"
    }
  },
  "skills": {}
}